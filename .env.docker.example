# ════════════════════════════════════════════════════════════════════════════
#  FarmTrace Docker Environment Template
#  Copy this file to .env.docker and fill in real values before running:
#    cp .env.docker.example .env.docker
#    docker compose up --build
# ════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string

# ── Frontend (used by nginx reverse-proxy) ────────────────────────────────
FRONTEND_URL=http://localhost

# ── MongoDB (overridden per-service in compose) ───────────────────────────
MONGO_URI=mongodb://mongo:27017/farmtrace

# ── Redis (BullMQ) ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://farmtrace:farmtrace_secret@postgres:5432/farmtrace

# ── Elasticsearch (Bonsai) ───────────────────────────────────────────────
ELASTICSEARCH_URL=https://your-cluster.bonsai.io

# ── Blockchain ──────────────────────────────────────────────────────────
PRIVATE_KEY=your-eth-wallet-private-key-here
CONTRACT_ADDRESS=your-deployed-contract-address
RPC_URL=https://sepolia.infura.io/v3/your-project-id

# ── Cloudinary (media uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Pinata (IPFS) ────────────────────────────────────────────────────────
PINATA_JWT=your-pinata-jwt-token
PINATA_GATEWAY=https://your-gateway.mypinata.cloud

# ── Razorpay ────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=AIzaSy_xxx

# ── SMS (MSG91) ──────────────────────────────────────────────────────────
SMS_API_KEY=your-msg91-auth-key
SMS_SENDER_ID=FARMTC
SMS_TEMPLATE_ID=your-dlt-approved-template-id

# ── Error Monitoring (Sentry) ────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/project-id
# (Frontend env — injected at build time via docker-compose or CI)
# REACT_APP_SENTRY_DSN=https://xxx@sentry.io/project-id

# ── Analytics (PostHog) ──────────────────────────────────────────────────
# REACT_APP_POSTHOG_KEY=phc_xxx
# REACT_APP_POSTHOG_HOST=https://us.i.posthog.com

# ── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=FarmTrace <noreply@farmtrace.in>
